<?xml version='1.0' encoding='utf-8'?>
<configuration>
  <input>
    <net-file value="../network/mandaue.net.xml" />
    <route-files value="CORRIDOR_PM.rou.xml" />
    <additional-files value="CORRIDOR_PM_fixed.add.xml,ST50_CORRIDOR_PM_crossings.add.xml,../network/study_locations.add.xml" />
  </input>
  <time>
    <begin value="0" />
    <end value="14400" />
    <step-length value="0.5" />
  </time>
  <processing>
    <scale value="0.5" />
    <lateral-resolution value="-1" />
    <time-to-teleport value="-1" />
    <collision.action value="warn" />
    <collision.check-junctions value="true" />
  </processing>
  <output>
    <tripinfo-output value="../results/ST50_CORRIDOR_PM/tripinfo.xml" />
    <tripinfo-output.write-unfinished value="true" />
    <tripinfo-output.write-undeparted value="true" />
    <summary-output value="../results/ST50_CORRIDOR_PM/summary.xml" />
    <summary-output.period value="10" />
    <collision-output value="../results/ST50_CORRIDOR_PM/collisions.xml" />
  </output>
  <report>
    <no-step-log value="true" />
    <duration-log.statistics value="true" />
    <error-log value="../results/ST50_CORRIDOR_PM/warnings.log" />
  </report>
  <random_number>
    <seed value="42" />
  </random_number>
  <gui_only>
    <gui-settings-file value="CORRIDOR_view.xml" />
  </gui_only>
</configuration>